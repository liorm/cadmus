{
	"name": "@cadmus/cli",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"cadmus": "./src/cli.ts"
	},
	"scripts": {
		"start": "bun run src/cli.ts",
		"build": "bun build --compile src/cli.ts --outfile dist/cadmus",
		"build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 src/cli.ts --outfile dist/cadmus-darwin-arm64",
		"build:darwin-x64": "bun build --compile --target=bun-darwin-x64 src/cli.ts --outfile dist/cadmus-darwin-x64",
		"build:darwin": "bun run build:darwin-arm64 && bun run build:darwin-x64",
		"build:linux-arm64": "bun build --compile --target=bun-linux-arm64 src/cli.ts --outfile dist/cadmus-linux-arm64",
		"build:linux-x64": "bun build --compile --target=bun-linux-x64 src/cli.ts --outfile dist/cadmus-linux-x64",
		"build:linux": "bun run build:linux-arm64 && bun run build:linux-x64",
		"build:all": "bun run build:linux && bun run build:darwin"
	},
	"dependencies": {
		"@cadmus/contract": "workspace:*"
	}
}
