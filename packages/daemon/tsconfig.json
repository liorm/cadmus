{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["bun"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"rootDir": "..",
		"esModuleInterop": true,
		"resolveJsonModule": true
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.ts",
		"../worker/src/tools-env/wire.ts",
		"../worker/src/tools-env/wire-call.ts",
		"../worker/src/tools-env/wire-env.ts"
	]
}
