{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cadmus",
	"main": "packages/worker/src/index.ts",
	"compatibility_date": "2026-10-18",
	"compatibility_flags": ["nodejs_compat"],
	"preview_urls": true,
	"assets": {
		"directory": "./packages/web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/health",
			"/protocol/schema",
			"/ws",
			"/tools-env/ws",
			"/events",
			"/rpc",
			"/api/*"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "CADMUS_BOT_FAMILY",
				"class_name": "CadmusBotFamilyDO"
			},
			{
				"name": "CADMUS_ENV",
				"class_name": "CadmusEnvDO"
			}
		]
	},
	"keep_vars": true,
	"d1_databases": [
		{
			"binding": "CADMUS_ADMIN_DB",
			"database_name": "cadmus-admin",
			"database_id": "1ae99680-9dab-4883-8449-4a7dd0f53212",
			"preview_database_id": "5c25c5bf-879d-4a5b-a31f-ba6d8a3c85a8"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CADMUS_CACHE_KV",
			"id": "d5fde8e98af64220a78c70cddd4eed16"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["CadmusBotFamilyDO"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["CadmusEnvDO"]
		}
	],
	"vars": {
		"CADMUS_AUTH_SECRET": "dev-cadmus-secret",
		"CADMUS_ENCRYPTION_KEY": "dev-cadmus-encryption-key-32bytes!",
		"CADMUS_DEFAULT_TIMEZONE": "UTC",
		"CADMUS_HARVEST_DELAY_MS": "60000",
		"CADMUS_LOG_LEVEL": "debug"
	},
	"previews": {
		"d1_databases": [
			{
				"binding": "CADMUS_ADMIN_DB",
				"database_name": "cadmus-admin-staging",
				"database_id": "5c25c5bf-879d-4a5b-a31f-ba6d8a3c85a8"
			}
		],
		"kv_namespaces": [
			{
				"binding": "CADMUS_CACHE_KV",
				"id": "730ad07f537b4d4cb64f31587c9f0946"
			}
		],
		"durable_objects": {
			"bindings": [
				{
					"name": "CADMUS_BOT_FAMILY",
					"class_name": "CadmusBotFamilyDO"
				},
				{
					"name": "CADMUS_ENV",
					"class_name": "CadmusEnvDO"
				}
			]
		},
		"vars": {
			"CADMUS_AUTH_SECRET": "dev-cadmus-secret",
			"CADMUS_ENCRYPTION_KEY": "dev-cadmus-encryption-key-32bytes!",
			"CADMUS_DEFAULT_TIMEZONE": "UTC",
			"CADMUS_HARVEST_DELAY_MS": "60000",
			"CADMUS_LOG_LEVEL": "debug",
			"IS_PREVIEW": "true"
		}
	}
}
