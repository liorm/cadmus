{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cadmus",
	"main": "packages/worker/src/index.ts",
	"compatibility_date": "2026-10-18",
	"compatibility_flags": ["nodejs_compat"],
	"preview_urls": true,
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": false
		}
	},
	"assets": {
		"directory": "./packages/web-app/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/health",
			"/protocol/schema",
			"/ws",
			"/tools-env/*",
			"/events",
			"/rpc",
			"/api/*",
			"/auth/*"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "CADMUS_BOT_FAMILY",
				"class_name": "CadmusBotFamilyDO"
			},
			{
				"name": "CADMUS_ENV",
				"class_name": "CadmusEnvDO"
			},
			{
				"name": "CADMUS_AUTH_LIMITER",
				"class_name": "CadmusAuthLimiterDO"
			}
		]
	},
	"keep_vars": true,
	"d1_databases": [
		{
			"binding": "CADMUS_ADMIN_DB",
			"database_name": "cadmus-admin",
			"database_id": "6149a8ca-f5f8-4040-bca9-c8f03a6fc402",
			"preview_database_id": "bd31fe4a-31f3-4a67-9f76-73907732557f"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CADMUS_CACHE_KV",
			"id": "43a4a1a4ad7f40ffbceca9035c8cc4e1"
		}
	],
	"ratelimits": [
		{
			"name": "CADMUS_AUTH_RATELIMIT",
			"namespace_id": "3001",
			"simple": { "limit": 20, "period": 60 }
		},
		{
			"name": "CADMUS_AUTH_REFRESH_RATELIMIT",
			"namespace_id": "3005",
			"simple": { "limit": 120, "period": 60 }
		},
		{
			"name": "CADMUS_AUTH_RPC_RATELIMIT",
			"namespace_id": "3003",
			"simple": { "limit": 60, "period": 60 }
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["CadmusBotFamilyDO"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["CadmusEnvDO"]
		},
		{
			"tag": "v3",
			"deleted_classes": ["CadmusBotFamilyDO", "CadmusEnvDO"]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": ["CadmusBotFamilyDO", "CadmusEnvDO"]
		},
		{
			"tag": "v5",
			"new_sqlite_classes": ["CadmusAuthLimiterDO"]
		},
		{
			"tag": "v6",
			"deleted_classes": ["CadmusBotFamilyDO", "CadmusEnvDO", "CadmusAuthLimiterDO"]
		},
		{
			"tag": "v7",
			"new_sqlite_classes": ["CadmusBotFamilyDO", "CadmusEnvDO", "CadmusAuthLimiterDO"]
		}
	],
	"vars": {
		"CADMUS_PUBLIC_URL": "https://cadmus.purelogicstudios.com",
		"CADMUS_DEFAULT_TIMEZONE": "UTC",
		"CADMUS_HARVEST_DELAY_MS": "60000",
		"CADMUS_LOG_LEVEL": "debug",
		"CADMUS_DEPLOY_ENV": "production"
	},
	"previews": {
		"d1_databases": [
			{
				"binding": "CADMUS_ADMIN_DB",
				"database_name": "cadmus-admin-staging",
				"database_id": "bd31fe4a-31f3-4a67-9f76-73907732557f"
			}
		],
		"kv_namespaces": [
			{
				"binding": "CADMUS_CACHE_KV",
				"id": "04c09d21c0dc498db9cf1d9b661b7efd"
			}
		],
		"durable_objects": {
			"bindings": [
				{
					"name": "CADMUS_BOT_FAMILY",
					"class_name": "CadmusBotFamilyDO"
				},
				{
					"name": "CADMUS_ENV",
					"class_name": "CadmusEnvDO"
				},
				{
					"name": "CADMUS_AUTH_LIMITER",
					"class_name": "CadmusAuthLimiterDO"
				}
			]
		},
		"ratelimits": [
			{
				"name": "CADMUS_AUTH_RATELIMIT",
				"namespace_id": "3002",
				"simple": { "limit": 20, "period": 60 }
			},
			{
				"name": "CADMUS_AUTH_REFRESH_RATELIMIT",
				"namespace_id": "3006",
				"simple": { "limit": 120, "period": 60 }
			},
			{
				"name": "CADMUS_AUTH_RPC_RATELIMIT",
				"namespace_id": "3004",
				"simple": { "limit": 60, "period": 60 }
			}
		],
		"vars": {
			"CADMUS_PUBLIC_URL": "",
			"CADMUS_DEFAULT_TIMEZONE": "UTC",
			"CADMUS_HARVEST_DELAY_MS": "60000",
			"CADMUS_LOG_LEVEL": "debug",
			"IS_PREVIEW": "true"
		}
	}
}
