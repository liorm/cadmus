{
	"name": "cadmus",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"tui": "bun run --cwd tui start",
		"web:dev": "bun run --cwd web dev",
		"web:build": "bun run --cwd web build",
		"web:test": "bun run --cwd web test",
		"typecheck": "bun check && bun run --cwd tui typecheck && bun run --cwd web typecheck",
		"lint": "biome check",
		"format": "biome check --write",
		"format:check": "biome format",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run",
		"check:all": "bun run web:test && bun run web:build && bun run format:check && biome check && bun run typecheck && bun run test"
	},
	"dependencies": {
		"@earendil-works/chord": "^1.3.0",
		"@earendil-works/pi-ai": "^1.3.0",
		"@earendil-works/pi-durable": "^1.3.0",
		"chrono-node": "^2.10.3",
		"croner": "^10.0.1",
		"diff": "^8.0.4",
		"parse-duration": "^2.1.9",
		"typebox": "^1.3.27"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vitest-plugin": "^1.4.4",
		"@cloudflare/workers-types": "^5.20261018.1",
		"@types/bun": "^1.4.3",
		"@types/diff": "^8.0.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.1"
	},
	"engines": {
		"bun": ">=1.4.3"
	}
}
