{
	"name": "pi-bot",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "bun src/main.ts",
		"dev": "PI_BOT_DEV=1 bun --watch src/main.ts",
		"typecheck": "bun check && bun check -p tsconfig.web.json",
		"lint": "biome check",
		"format": "biome check --write",
		"format:check": "biome format",
		"test": "bun test",
		"check:all": "bun run format:check && biome check && bun run typecheck && bun test",
		"login": "bun scripts/auth.ts login",
		"logout": "bun scripts/auth.ts logout",
		"auth:status": "bun scripts/auth.ts status",
		"coverage": "bun test --coverage",
		"build:binary": "bun scripts/build-binary.ts"
	},
	"dependencies": {
		"@earendil-works/chord": "^1.1.0",
		"@earendil-works/pi-ai": "^1.1.0",
		"@earendil-works/pi-durable": "^1.1.0",
		"@preact/signals": "^2.11.3",
		"grammy": "^1.46.0",
		"preact": "^11.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	},
	"engines": {
		"bun": ">=1.4.2"
	}
}
