{
	"name": "cadmus",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run web:build",
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --keep-vars",
		"deploy:preview": "wrangler preview",
		"tui": "bun run --cwd packages/tui start",
		"web:dev": "bun run --cwd packages/web dev",
		"web:build": "bun run --cwd packages/web build",
		"web:test": "bun run --cwd packages/web test",
		"typecheck": "bun check && bunx tsc -p packages/contract/tsconfig.json --noEmit && bun run --cwd packages/tui typecheck && bun run --cwd packages/web typecheck && bunx tsc -p packages/daemon/tsconfig.json --noEmit && bunx tsc -p packages/worker/tsconfig.json --noEmit",
		"lint": "biome check",
		"format": "biome check --write",
		"format:check": "biome format",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run",
		"contract:gen": "bun scripts/generate-contract.ts",
		"contract:check": "bun scripts/generate-contract.ts --check",
		"boundaries": "bun scripts/check-boundaries.ts",
		"test:conformance": "bun test tests/conformance && vitest run --config vitest.conformance.config.ts",
		"test:daemon": "bun test packages/daemon/tests",
		"daemon": "bun packages/daemon/src/cli.ts",
		"daemon:build:darwin-arm64": "mkdir -p packages/daemon/dist && bun build --compile --target=bun-darwin-arm64 packages/daemon/src/cli.ts --outfile packages/daemon/dist/cadmus-daemon-darwin-arm64",
		"daemon:build:darwin-x64": "mkdir -p packages/daemon/dist && bun build --compile --target=bun-darwin-x64 packages/daemon/src/cli.ts --outfile packages/daemon/dist/cadmus-daemon-darwin-x64",
		"daemon:build:darwin": "bun run daemon:build:darwin-arm64 && bun run daemon:build:darwin-x64",
		"daemon:build:linux-arm64": "mkdir -p packages/daemon/dist && bun build --compile --target=bun-linux-arm64 packages/daemon/src/cli.ts --outfile packages/daemon/dist/cadmus-daemon-linux-arm64",
		"daemon:build:linux-x64": "mkdir -p packages/daemon/dist && bun build --compile --target=bun-linux-x64 packages/daemon/src/cli.ts --outfile packages/daemon/dist/cadmus-daemon-linux-x64",
		"daemon:build:linux": "bun run daemon:build:linux-arm64 && bun run daemon:build:linux-x64",
		"daemon:build:local": "mkdir -p packages/daemon/dist && bun build --compile packages/daemon/src/cli.ts --outfile packages/daemon/dist/cadmus-daemon",
		"daemon:build:all": "bun run daemon:build:linux && bun run daemon:build:darwin",
		"daemon:build": "bun run daemon:build:all",
		"test:unit": "bun test scripts",
		"check:all": "bun run boundaries && bun run contract:check && bun run test:unit && bun run web:test && bun run web:build && bun run format:check && biome check && bun run typecheck && bun run test:daemon && bun run test:conformance && bun run test"
	},
	"dependencies": {
		"@cadmus/contract": "workspace:*",
		"@cadmus/worker": "workspace:*",
		"@earendil-works/chord": "^1.3.0",
		"@earendil-works/pi-ai": "^1.3.0",
		"@earendil-works/pi-durable": "^1.3.0",
		"chrono-node": "^2.10.3",
		"croner": "^10.0.1",
		"diff": "^8.0.4",
		"just-bash": "^3.6.0",
		"parse-duration": "^2.1.9",
		"typebox": "^1.3.27"
	},
	"devDependencies": {
		"@apidevtools/swagger-parser": "^13.1.0",
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vitest-plugin": "^1.4.4",
		"@cloudflare/workers-types": "^5.20261018.1",
		"@types/bun": "^1.4.3",
		"@types/diff": "^8.0.0",
		"cf": "^1.0.0-beta.21",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.1"
	},
	"engines": {
		"bun": ">=1.4.3"
	}
}
