# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather. Leave empty to run the web page only.
# At least one of TELEGRAM_BOT_TOKEN or WEB_TOKEN must be set.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to talk to the bot.
# Empty = nobody (every message is ignored and logged).
TELEGRAM_ALLOWED_USERS=
# Long-poll timeout in seconds (default 30).
# TELEGRAM_POLL_TIMEOUT_SEC=30
# Optional local Bot API server root (default https://api.telegram.org).
# TELEGRAM_API_ROOT=

# --- Model -----------------------------------------------------------------
# Main model as <provider>/<modelId>, using any @earendil-works/pi-ai built-in provider.
# Examples (pick one; NOT decided yet): anthropic/<model>, openai/<model>, xai/<model>, openrouter/<vendor>/<model>
# "faux/echo" is a built-in offline echo model for smoke tests (no key needed).
PI_MODEL=faux/echo
# Optional: off | minimal | low | medium | high | xhigh
# PI_THINKING_LEVEL=
# Reserved for later phases (review fork / memory-capture gate); parsed but unused in Phase 0.
# PI_REVIEW_MODEL=
# PI_GATE_MODEL=
#
# Provider API keys are read by pi-ai from the provider's standard env var, e.g.
# ANTHROPIC_API_KEY, OPENAI_API_KEY, XAI_API_KEY, OPENROUTER_API_KEY, GEMINI_API_KEY.

# --- Web -------------------------------------------------------------------
# Shared door for the local page. Required when TELEGRAM_BOT_TOKEN is empty.
# Unset: the page does not listen. Telegram still runs when its token is set.
# Open http://127.0.0.1:8787/?token=<WEB_TOKEN> once; the browser keeps an HttpOnly cookie.
# The page talks, edits knowledge, and edits schedules. A per-bot Telegram token is set there
# and is stored on the bot, not in this file.
# WEB_TOKEN=
# WEB_HOST=127.0.0.1
# WEB_PORT=8787

# --- Runtime ---------------------------------------------------------------
# Where durable.sqlite, owner.lock, schedules.sqlite, and bots/<id>/ live (default ./data).
# PI_BOT_HOME=./data
# IANA timezone for the daily date line and for cron (default: system zone).
# PI_BOT_TZ=Asia/Jerusalem
# How long a chat stays idle before the knowledge harvest fork (default 60000).
# PI_BOT_HARVEST_DELAY_MS=60000
# LOG_LEVEL=info
