# --- Web -------------------------------------------------------------------
# Shared door for the local page.
# Open http://127.0.0.1:8787/?token=<WEB_TOKEN> once; the browser keeps an HttpOnly cookie.
# The page talks, edits knowledge, and edits schedules.
WEB_TOKEN=change-me
# WEB_HOST=127.0.0.1
# WEB_PORT=8787

# --- Model -----------------------------------------------------------------
# Each bot stores its own <provider>/<modelId>. There is no process-wide model.
# The page offers the built-in providers it knows (xAI, and the offline faux/echo model).
# Provider API keys are read by pi-ai from the provider's standard env var, e.g.
# ANTHROPIC_API_KEY, OPENAI_API_KEY, XAI_API_KEY, OPENROUTER_API_KEY, GEMINI_API_KEY.
# A stored OAuth login (bun run login <provider>) is preferred when present.
# Creating a bot, and the next start, fail when that bot's provider has no credentials.
# WEB_HOST=127.0.0.1
# WEB_PORT=8787
# `bun run dev` sets this. The page rebuilds when src/channels/web/ui changes,
# and bun --watch restarts the process when server code changes.
# PI_BOT_DEV=1

# --- Runtime ---------------------------------------------------------------
# Where durable.sqlite, owner.lock, schedules.sqlite, and bots/<id>/ live (default ./data).
# PI_BOT_HOME=./data
# IANA timezone for the daily date line and for cron (default: system zone).
# PI_BOT_TZ=Asia/Jerusalem
# How long a chat stays idle before the knowledge harvest fork (default 60000).
# PI_BOT_HARVEST_DELAY_MS=60000
# LOG_LEVEL=debug
