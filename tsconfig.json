{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ESNext"],
		"types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"resolveJsonModule": true
	},
	"include": ["packages/worker/src/**/*", "e2e/**/*"]
}
