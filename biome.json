{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!docs",
			"!packages/web/dist",
			"!packages/web/node_modules",
			"!packages/daemon/dist"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/web/**", "packages/tui/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"src",
											"src/**",
											"worker",
											"worker/**",
											"daemon",
											"daemon/**",
											"../src",
											"../src/**",
											"../../src",
											"../../src/**",
											"../../../src",
											"../../../src/**",
											"../../../../src",
											"../../../../src/**",
											"../worker",
											"../worker/**",
											"../../worker",
											"../../worker/**",
											"../../../worker",
											"../../../worker/**",
											"../../../../worker",
											"../../../../worker/**",
											"../daemon",
											"../daemon/**",
											"../../daemon",
											"../../daemon/**",
											"../../../daemon",
											"../../../daemon/**",
											"../../../../daemon",
											"../../../../daemon/**"
										],
										"message": "Clients import @cadmus/contract/types, @cadmus/contract/routes, and @cadmus/contract/tools only. Backend source is off limits."
									},
									{
										"group": [
											"@cadmus/contract",
											"@cadmus/contract/schemas",
											"@cadmus/contract/schemas/**",
											"@cadmus/contract/openapi.json",
											"@cadmus/contract/asyncapi.json",
											"@cadmus/contract/**",
											"!@cadmus/contract/types",
											"!@cadmus/contract/routes",
											"!@cadmus/contract/tools"
										],
										"message": "Clients may import only @cadmus/contract/types, @cadmus/contract/routes, and @cadmus/contract/tools."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
