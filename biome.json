{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!docs",
			"!packages/web-app/src/styles/app.css",
			"!packages/login-app/src/styles/login.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/web-app/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"**/packages/worker/**",
											"**/packages/daemon/**",
											"**/packages/login-app/**",
											"@cadmus/**",
											"!@cadmus/contract/types",
											"!@cadmus/contract/routes",
											"!@cadmus/contract/tools",
											"!@cadmus/contract/client"
										],
										"message": "Clients may import only @cadmus/contract/types, @cadmus/contract/routes, @cadmus/contract/tools, and @cadmus/contract/client."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/login-app/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"**/packages/worker/**",
											"**/packages/daemon/**",
											"**/packages/web-app/**",
											"@cadmus/**",
											"!@cadmus/contract/types",
											"!@cadmus/contract/routes",
											"!@cadmus/contract/tools",
											"!@cadmus/contract/client"
										],
										"message": "Login app may not import web-app, worker, daemon, or restricted contract subpaths."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/cli/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"**/packages/worker/**",
											"**/packages/daemon/**",
											"@cadmus/**",
											"!@cadmus/contract/types",
											"!@cadmus/contract/routes",
											"!@cadmus/contract/tools",
											"!@cadmus/contract/client",
											"!@cadmus/contract/schemas"
										],
										"message": "The CLI may import contract types, routes, tools, client, and schemas only."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["e2e/**", "!e2e/helpers.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["../*", "../**", "@cadmus/**", "cloudflare:test"],
										"message": "E2E test files must import contract utilities and the worker fixture through ./helpers.js only."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["e2e/helpers.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../*",
											"../**",
											"@cadmus/**",
											"!@cadmus/contract/types",
											"!@cadmus/contract/routes",
											"!@cadmus/contract/tools",
											"!@cadmus/contract/client",
											"!@cadmus/contract/schemas"
										],
										"message": "e2e/helpers.ts may import only @cadmus/contract/{types,routes,tools,client,schemas}."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
